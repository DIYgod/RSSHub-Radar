{
  "name": "rsshub-radar",
  "displayName": "RSSHub Radar",
  "version": "2.3.1",
  "description": "__MSG_extensionDescription__",
  "author": "DIYgod",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "dev:firefox": "wxt -b firefox --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "zip": "wxt zip && mkdir -p build && cp .output/rsshub-radar-$(node -p \"require('./package.json').version\")-chrome.zip build/chrome-mv3-prod.zip",
    "zip:firefox": "wxt zip -b firefox --mv3 && mkdir -p build && cp .output/rsshub-radar-$(node -p \"require('./package.json').version\")-firefox.zip build/firefox-mv3-prod.zip",
    "safari-convert": "xcrun safari-web-extension-converter .output/safari-mv3 --project-location build --bundle-identifier app.rsshub.RSSHub-Radar --force --no-open --no-prompt && plutil -insert LSApplicationCategoryType -string public.app-category.productivity \"build/RSSHub Radar/macOS (App)/Info.plist\"",
    "safari-zip": "zip -r build/safari-mv3-prod.zip \"build/RSSHub Radar\"",
    "build:safari:zip": "pnpm build:safari && pnpm safari-convert && pnpm safari-zip",
    "package": "pnpm zip && pnpm zip:firefox",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@iconify-json/mingcute": "^1.2.8",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "async-lock": "^1.4.1",
    "blueimp-md5": "^2.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "foxact": "^0.3.12",
    "he": "2.0.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-router": "^8.5.1",
    "route-recognizer": "^0.3.4",
    "rss-parser": "3.13.0",
    "tailwind-merge": "^3.7.0",
    "tldts": "^7.4.19",
    "usehooks-ts": "^3.1.1",
    "xss": "1.0.17"
  },
  "devDependencies": {
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "prettier-package-json": "2.8.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "wxt": "^0.21.5"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
